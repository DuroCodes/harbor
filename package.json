{
  "name": "harbor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.11",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter harbor-mobile typecheck && bun run --filter harbor-plaid-proxy typecheck && bun run --filter @harbor/plaid-proxy typecheck"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "patchedDependencies": {
    "@expo/cli@57.0.14": "patches/@expo%2Fcli@57.0.14.patch"
  }
}
